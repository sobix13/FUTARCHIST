[Unit]
Description=FUTARCHIST Telegram worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=simple
User=futarchist
Group=futarchist
WorkingDirectory=/srv/futarchist
EnvironmentFile=/srv/futarchist/.env
ExecStart=/srv/futarchist/.venv/bin/python -m futarchist --mode bot
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/futarchist/data
TimeoutStopSec=35

[Install]
WantedBy=multi-user.target
